@@ -0,0 +1,187 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Native placement descriptors can be prepared without announcing residency."""
+
+from dataclasses import dataclass
+from types import SimpleNamespace
+
+from sglang.srt.disaggregation.kv_events import BlockRemoved, StorageMedium
+from sglang.srt.mem_cache.events import KVCacheEventRecorder, native_event_hash
+from sglang.srt.mem_cache.utils import get_storage_hash_str
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=10, suite="base-a-test-cpu")
+
+
+@dataclass
+class Key:
+    token_ids: list[int]
+    extra_key: str | None = None
+    cache_salt: str | None = None
+    is_bigram: bool = False
+
+    def __len__(self) -> int:
+        return len(self.token_ids)
+
+
+def test_prepared_descriptors_match_captured_gpu_events() -> None:
+    # Captured from unmodified 43e4e84731 KVCacheEventRecorder.record_store,
+    # using its native SHA256 extension, page_size=4 and tokens range(16).
+    captured_hashes = [
+        -4977211910723114241,
+        90435953025800507,
+        -190329471204100490,
+        -4051358142079366242,
+    ]
+    root = SimpleNamespace(parent=None, key=Key([]), hash_value=[])
+    parent = SimpleNamespace(parent=root, key=Key(list(range(8))), hash_value=None)
+    child = SimpleNamespace(parent=parent, key=Key(list(range(8, 16))), hash_value=None)
+    recorder = KVCacheEventRecorder(enabled=True, page_size=4)
+    gpu_remove = BlockRemoved(block_hashes=[42], medium=StorageMedium.GPU)
+    recorder.enqueue(gpu_remove)
+
+    hashes = get_storage_hash_str(parent.key, page_size=4)
+    hashes += get_storage_hash_str(child.key, hashes[-1], page_size=4)
+    assert [native_event_hash(h) for h in hashes] == captured_hashes
+    assert recorder.take() == [gpu_remove]
+    recorder.record_store(parent)
+    recorder.record_store(child)
+    event = recorder.take()[0]
+    assert event.block_hashes == captured_hashes
+    assert event.parent_block_hash is None
+    assert event.token_ids == list(range(16))
+    assert event.block_size == 4
+
+
+def test_nonpublisher_rank_prepares_identities_without_native_events() -> None:
+    recorder = KVCacheEventRecorder(enabled=False, page_size=4)
+    root = SimpleNamespace(parent=None, key=Key([]), hash_value=[])
+    node = SimpleNamespace(parent=root, key=Key(list(range(4))), hash_value=None)
+    hashes = get_storage_hash_str(node.key, page_size=4)
+    assert [native_event_hash(h) for h in hashes] == [-4977211910723114241]
+    recorder.record_store(node)
+    assert recorder.take() == []
+
+
+def test_lmcache_take_events_keeps_gpu_events_and_drains_cpu_on_caller_thread(
+    monkeypatch,
+):
+    import threading
+
+    from lmcache.utils import CacheRemoveEvent
+
+    from sglang.srt.mem_cache.storage.lmcache.lmcache_unified_radix_cache import (
+        LMCacheUnifiedRadixCache,
+    )
+    from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache
+
+    recorder = KVCacheEventRecorder(enabled=True, page_size=4)
+    gpu_event = BlockRemoved(block_hashes=[11], medium=StorageMedium.GPU)
+    recorder.enqueue(gpu_event)
+    monkeypatch.setattr(UnifiedRadixCache, "take_events", lambda self: recorder.take())
+    owner_thread = threading.get_ident()
+    cpu_queue = [CacheRemoveEvent(block_hashes=[23], medium="CPU")]
+
+    def drain_cpu():
+        assert threading.get_ident() == owner_thread
+        events = list(cpu_queue)
+        cpu_queue.clear()
+        return events
+
+    cache = LMCacheUnifiedRadixCache.__new__(LMCacheUnifiedRadixCache)
+    cache.lmcache_connector = SimpleNamespace(get_kv_events=drain_cpu)
+
+    assert cache.take_events() == [
+        gpu_event,
+        BlockRemoved(block_hashes=[23], medium=StorageMedium.CPU),
+    ]
+    assert gpu_event.medium == StorageMedium.GPU
+    assert cache.take_events() == []
+
+
+def test_store_hashing_is_incremental_and_request_scoped(monkeypatch):
+    import torch
+    from lmcache.v1.multiprocess.custom_types import KVEventProfile
+
+    from sglang.srt.mem_cache import utils
+    from sglang.srt.mem_cache.base_prefix_cache import CacheRequestHandle
+    from sglang.srt.mem_cache.storage.lmcache.lmcache_unified_radix_cache import (
+        LMCacheUnifiedRadixCache,
+    )
+    from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache
+
+    hashed_lengths, submitted, finished = [], [], []
+    native_hash = utils.get_storage_hash_str
+
+    def observe_hash(key, prior_hash=None, page_size=None):
+        hashed_lengths.append(len(key))
+        return native_hash(key, prior_hash, page_size)
+
+    monkeypatch.setattr(utils, "get_storage_hash_str", observe_hash)
+    monkeypatch.setattr(UnifiedRadixCache, "checkpoint", lambda *args, **kw: None)
+    monkeypatch.setattr(
+        UnifiedRadixCache,
+        "match_prefix",
+        lambda self, params: SimpleNamespace(
+            device_prefix_len=len(params.key),
+            last_device_node=1,
+            best_match_node=1,
+        ),
+    )
+    cache = LMCacheUnifiedRadixCache.__new__(LMCacheUnifiedRadixCache)
+    cache.tree_core = SimpleNamespace(is_eagle=False, page_size=4)
+    cache._request_event_hashes = {}
+    cache._mamba_component = None
+    cache._pending_store_counts = {}
+    cache._session_finish_requested = set()
+    cache._external_flows = {}
+    cache.prefetch_loaded_tokens_by_reqid = {}
+    cache.prefetch_loaded_storage_start_by_reqid = {}
+    monkeypatch.setattr(
+        cache, "_publish_external_loaded_prefix", lambda *args, **kw: None
+    )
+    monkeypatch.setattr(cache, "_retire_loaded_flow", lambda *args: None)
+    monkeypatch.setattr(cache, "path_device_indices", lambda node: torch.arange(4, 20))
+    monkeypatch.setattr(
+        cache, "inc_lock_ref", lambda node: SimpleNamespace(to_dec_params=lambda: None)
+    )
+    monkeypatch.setattr(cache, "dec_lock_ref", lambda *args: None)
+    progress = {"start": 0}
+
+    def submit(rid, tokens, indices, **kwargs):
+        submitted.append(kwargs["event_bindings"])
+        progress["start"] = len(tokens)
+        return None
+
+    cache.lmcache_connector = SimpleNamespace(
+        event_profile=KVEventProfile("sglang-native", 4),
+        chunk_size=8,
+        get_store_start=lambda rid, end: progress["start"],
+        parallel_all_reduce=lambda *args: None,
+        device_indices_by_group=lambda indices, **kwargs: [indices],
+        submit_store=submit,
+        build_cache_salt=lambda *args: "",
+        finish_request=finished.append,
+    )
+    req = SimpleNamespace(
+        rid="request",
+        extra_key=None,
+        cache_salt=None,
+        full_untruncated_fill_ids=list(range(16)),
+        finished=lambda: False,
+    )
+    cache.checkpoint(req, up_to=8)
+    cache.checkpoint(req, up_to=16)
+    assert hashed_lengths == [8, 8]
+    assert submitted[1][0].parent_block_hash == submitted[0][0].block_hashes[-1]
+    progress["start"] = 0  # Retrying failed storage reuses immutable native identities.
+    cache.checkpoint(req, up_to=16)
+    assert hashed_lengths == [8, 8]
+    assert submitted[2] == submitted[0] + submitted[1]
+
+    cache.release_aborted_request(CacheRequestHandle(req.rid, 0))
+    assert finished == [req.rid]
+    progress["start"] = 0
+    req.full_untruncated_fill_ids = list(range(16, 24))
+    cache.checkpoint(req, up_to=8)
+    assert hashed_lengths == [8, 8, 8]
+    assert submitted[-1][0].block_hashes != submitted[0][0].block_hashes
