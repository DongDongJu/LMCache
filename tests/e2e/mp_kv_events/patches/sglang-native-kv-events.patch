+
+    def _socket(self, kind, endpoint):
+        socket = zmq.Context.instance().socket(kind)
+        socket.setsockopt(zmq.LINGER, 0)
+        socket.setsockopt(zmq.RCVTIMEO, 3000)
+        socket.connect(endpoint)
+        self.addCleanup(socket.close)
