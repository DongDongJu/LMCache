+    def _store_event_bindings(
+        self, rid: str, key: RadixKey, start: int, end: int
+    ) -> tuple[EventBinding, ...]:
+        """Prepare native identities incrementally while request tokens exist.
+
+        Both TreeCore backends use the same native page hash algorithm. The
+        native helper and recorder's conversion preserve its chain and signed
+        wire representation without touching a backend's publication queue.
+        """
+        from lmcache.v1.multiprocess.custom_types import EventBinding
+
+        from sglang.srt.mem_cache.events import native_event_hash
+        from sglang.srt.mem_cache.utils import get_storage_hash_str
+
+        profile = self.lmcache_connector.event_profile
+        if profile is None:
+            return ()
+        block_size = profile.block_size
+        chunk_size = self.lmcache_connector.chunk_size
+        if start % chunk_size or end % chunk_size or len(key) != end:
+            raise ValueError(
+                "Native SGLang STORE boundaries must align to LMCache chunks"
+            )
+        hashes = self._request_event_hashes.setdefault(rid, [])
+        hashed_tokens = len(hashes) * block_size
+        if end > hashed_tokens:
+            new_hashes = get_storage_hash_str(
+                key[hashed_tokens:end],
+                hashes[-1] if hashes else None,
+                page_size=block_size,
+            )
+            if not isinstance(new_hashes, list):
+                raise TypeError("Native page hashing did not return page descriptors")
+            hashes.extend(new_hashes)
+        tokens = key.raw_token_ids()
+        bindings = []
+        for offset in range(start, end, chunk_size):
+            first, last = offset // block_size, (offset + chunk_size) // block_size
+            bindings.append(
+                EventBinding(
+                    profile_id=profile.profile_id,
+                    block_hashes=tuple(
+                        native_event_hash(h) for h in hashes[first:last]
+                    ),
+                    parent_block_hash=native_event_hash(hashes[first - 1])
+                    if first
+                    else None,
+                    token_ids=tuple(tokens[offset : offset + chunk_size]),
+                    block_size=block_size,
+                )
+            )
+        return tuple(bindings)
