+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""KV-event policy errors must stay in frontend admission, before core enqueue."""
+
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from vllm import SamplingParams
+from vllm.config import KVTransferConfig
+from vllm.distributed.kv_transfer.kv_connector.factory import KVConnectorFactory
+from vllm.distributed.kv_transfer.kv_connector.v1.base import KVConnectorBase_V1
+from vllm.exceptions import VLLMValidationError
+from vllm.v1.engine import EngineCoreRequest
+from vllm.v1.engine.async_llm import AsyncLLM
+from vllm.v1.engine.input_processor import InputProcessor
+from vllm.v1.engine.llm_engine import LLMEngine
+
+pytestmark = pytest.mark.skip_global_cleanup
+
+
+class EventPolicy(KVConnectorBase_V1):
+    @classmethod
+    def validate_kv_event_request(cls, config, request: EngineCoreRequest) -> None:
+        if request.cache_salt:
+            raise VLLMValidationError("unsupported KV-event namespace")
+
+
+def request(salt: str | None) -> EngineCoreRequest:
+    return EngineCoreRequest(
+        request_id="request",
+        prompt_token_ids=[1, 2],
+        mm_features=None,
+        sampling_params=SamplingParams(max_tokens=1),
+        pooling_params=None,
+        arrival_time=0.0,
+        lora_request=None,
+        cache_salt=salt,
+        data_parallel_rank=None,
+    )
+
+
+def processor(enabled: bool) -> InputProcessor:
+    config = MagicMock()
+    config.model_config.try_get_generation_config.return_value = {}
+    config.model_config.supports_multimodal_inputs = False
+    config.model_config.logits_processors = None
+    config.cache_config.kv_sharing_fast_prefill = False
+    config.use_v2_model_runner = False
+    config.kv_transfer_config = KVTransferConfig(
+        kv_connector="EventPolicy", kv_role="kv_both"
+    )
+    config.kv_events_config.enable_kv_cache_events = enabled
+    renderer = MagicMock()
+    renderer._executor = None
+    return InputProcessor(config, renderer)
+
+
+def test_disabled_events_do_not_resolve_or_invoke_connector_policy() -> None:
+    with patch.object(KVConnectorFactory, "get_connector_class") as resolve:
+        frontend = processor(False)
+        frontend.validate_kv_event_request(request("allowed-when-disabled"))
+        resolve.assert_not_called()
+
+
+def test_default_connector_policy_accepts_existing_event_namespaces() -> None:
+    with patch.object(
+        KVConnectorFactory, "get_connector_class", return_value=KVConnectorBase_V1
+    ):
+        frontend = processor(True)
+    frontend.validate_kv_event_request(request("existing-namespace"))
+
+
+def test_enabled_policy_resolves_once_without_constructing_a_connector() -> None:
+    with patch.object(
+        KVConnectorFactory, "get_connector_class", return_value=EventPolicy
+    ) as resolve:
+        frontend = processor(True)
+        frontend.validate_kv_event_request(request(None))
+        for _ in range(2):
+            with pytest.raises(VLLMValidationError, match="namespace"):
+                frontend.validate_kv_event_request(request("tenant"))
+        resolve.assert_called_once()
+
+
+def test_prepared_async_request_is_rejected_before_core_enqueue() -> None:
+    with patch.object(
+        KVConnectorFactory, "get_connector_class", return_value=EventPolicy
+    ):
+        frontend = processor(True)
+    engine = SimpleNamespace(
+        errored=False,
+        vllm_config=frontend.vllm_config,
+        input_processor=frontend,
+        engine_core=MagicMock(),
+    )
+    core_request = request("tenant")
+    with pytest.raises(VLLMValidationError, match="namespace"):
+        asyncio.run(
+            AsyncLLM.add_request(engine, "request", core_request, core_request.params)
+        )
+    engine.engine_core.add_request_async.assert_not_called()
+
+
+def test_prepared_sync_request_is_rejected_before_core_enqueue() -> None:
+    with patch.object(
+        KVConnectorFactory, "get_connector_class", return_value=EventPolicy
+    ):
+        frontend = processor(True)
+    engine = SimpleNamespace(input_processor=frontend, engine_core=MagicMock())
+    core_request = request("tenant")
+    with pytest.raises(VLLMValidationError, match="namespace"):
+        LLMEngine.add_request(engine, "request", core_request, core_request.params)
+    engine.engine_core.add_request.assert_not_called()
