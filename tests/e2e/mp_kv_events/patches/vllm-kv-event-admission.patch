+
+
+def test_multi_connector_validates_kv_events_without_constructing_children(monkeypatch):
+    """Admission forwards child-specific configs and preserves the first rejection."""
+    from types import SimpleNamespace
+
+    from vllm.exceptions import VLLMValidationError
+    from vllm.v1.engine import EngineCoreRequest
+
+    seen = []
+
+    class Policy(MockConnector):
+        @classmethod
+        def validate_kv_event_request(cls, config, request):
+            seen.append(config.kv_transfer_config.kv_connector)
+            if seen[-1] == "reject":
+                raise VLLMValidationError("child KV-event namespace rejected")
+
+    monkeypatch.setattr(
+        KVConnectorFactory, "get_connector_class", lambda config: Policy
+    )
+    config = SimpleNamespace(
+        kv_transfer_config=KVTransferConfig(
+            kv_connector="MultiConnector",
+            kv_role="kv_both",
+            kv_connector_extra_config={
+                "connectors": [
+                    {"kv_connector": name, "kv_role": "kv_both"}
+                    for name in ("first", "reject", "last")
+                ]
+            },
+        )
+    )
+    request = EngineCoreRequest(
+        request_id="req",
+        prompt_token_ids=[1, 2],
+        mm_features=None,
+        sampling_params=SamplingParams(max_tokens=1),
+        pooling_params=None,
+        arrival_time=0.0,
+        lora_request=None,
+        cache_salt="tenant",
+        data_parallel_rank=None,
+    )
+    with pytest.raises(VLLMValidationError, match="child KV-event"):
+        MultiConnector.validate_kv_event_request(config, request)
+    assert seen == ["first", "reject"]
