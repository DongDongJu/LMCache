 use tokio_util::sync::CancellationToken;
 
 use dynamo_kv_router::protocols::*;
@@ -15,6 +17,214 @@ use dynamo_kv_router::zmq_wire::*;
 use crate::kv_router::metrics::kv_publisher_metrics;
 use crate::utils::zmq::{connect_sub_socket, multipart_message};
 
+const REPLAY_TIMEOUT: Duration = Duration::from_secs(5);
+const MAX_REPLAY_BATCHES: usize = 65_536;
+const REPLAY_READY_SEQUENCE: u64 = u64::MAX - 1;
+const REPLAY_NONCE_PREFIX: &[u8] = b"\xffkv-replay-ready:";
+
+struct ReplayRequest {
+    deadline: Instant,
+    required_cursor: Option<u64>,
+    received: usize,
+    nonce: Option<Vec<u8>>,
+    subscribed: bool,
+}
+
+/// Replay and live data share the native decoder and the existing normalizer.
+/// Read replay first while the bounded SUB socket queues live frames. A later
+/// live gap is repaired from the same retained log; duplicates never reach the
+/// normalizer's Store/Remove refcounts or consume publisher event IDs.
+struct NativeZmqSource {
+    live: crate::utils::zmq::SubSocket,
+    replay: Option<tmq::dealer::Dealer>,
+    request: Option<ReplayRequest>,
+    next_sequence: u64,
+    handshake: bool,
+    topic: Vec<u8>,
+    incarnation: Option<[u8; 16]>,
+}
+
+impl NativeZmqSource {
+    async fn connect(
+        endpoint: &str,
+        topic: &str,
+        replay_endpoint: Option<&str>,
+        handshake: bool,
+    ) -> Result<Self> {
+        anyhow::ensure!(
+            !handshake || replay_endpoint.is_some(),
+            "native KV replay handshake requires a replay endpoint"
+        );
+        let live = connect_sub_socket(endpoint, Some(topic)).await?;
+        let replay = replay_endpoint
+            .map(|endpoint| {
+                tmq::dealer::dealer(&tmq::Context::new())
+                    .set_linger(0)
+                    .connect(endpoint)
+            })
+            .transpose()?;
+        let mut source = Self {
+            live,
+            replay,
+            request: None,
+            next_sequence: 0,
+            handshake,
+            topic: topic.as_bytes().to_vec(),
+            incarnation: None,
+        };
+        if source.replay.is_some() {
+            source.request_replay(None).await?;
+        }
+        Ok(source)
+    }
+
+    async fn request_replay(&mut self, required_cursor: Option<u64>) -> Result<()> {
+        let mut frames = vec![Vec::new(), self.next_sequence.to_be_bytes().to_vec()];
+        let nonce = self.handshake.then(|| {
+            let mut nonce = REPLAY_NONCE_PREFIX.to_vec();
+            nonce.extend_from_slice(uuid::Uuid::new_v4().as_bytes());
+            frames.push(nonce.clone());
+            nonce
+        });
+        let deadline = Instant::now() + REPLAY_TIMEOUT;
+        timeout_at(
+            deadline,
+            self.replay
+                .as_mut()
+                .expect("replay is configured")
+                .send(frames),
+        )
+        .await
+        .context("native KV replay request timed out")??;
+        self.request = Some(ReplayRequest {
+            deadline,
+            required_cursor,
+            received: 0,
+            nonce,
+            subscribed: false,
+        });
+        Ok(())
+    }
+
+    async fn next(&mut self) -> Result<DecodedZmqKvBatch> {
+        loop {
+            let replaying = self.request.is_some();
+            let frames = if let Some(request) = self.request.as_mut() {
+                let frames = timeout_at(
+                    request.deadline,
+                    self.replay.as_mut().expect("replay is configured").next(),
+                )
+                .await
+                .context("native KV replay response timed out")?
+                .context("native KV replay stream ended")??;
+                let mut frames = multipart_message(frames);
+                anyhow::ensure!(
+                    frames.len() == 4 && frames[0].is_empty(),
+                    "invalid native KV replay envelope"
+                );
+                if let Some(nonce) = &request.nonce {
+                    if frames[2] == REPLAY_READY_SEQUENCE.to_be_bytes() {
+                        anyhow::ensure!(
+                            &frames[1] == nonce && !request.subscribed,
+                            "invalid native KV replay subscription challenge"
+                        );
+                        let incarnation: [u8; 16] = frames[3]
+                            .as_slice()
+                            .try_into()
+                            .context("native KV replay incarnation must contain 16 bytes")?;
+                        anyhow::ensure!(
+                            self.incarnation
+                                .is_none_or(|previous| previous == incarnation),
+                            "native KV publisher incarnation changed within one Dynamo source"
+                        );
+                        self.incarnation = Some(incarnation);
+                        // Filters from one SUB pipe reach XPUB in order. The
+                        // engine releases replay only after this nonce proves
+                        // our earlier native-topic filter is installed.
+                        self.live.subscribe(nonce)?;
+                        request.subscribed = true;
+                        continue;
+                    }
+                    anyhow::ensure!(
+                        request.subscribed,
+                        "native KV replay preceded subscription challenge"
+                    );
+                }
+                if frames[1].is_empty()
+                    && frames[2] == u64::MAX.to_be_bytes()
+                    && frames[3].is_empty()
+                {
+                    anyhow::ensure!(
+                        request
+                            .required_cursor
+                            .is_none_or(|cursor| self.next_sequence > cursor),
+                        "native KV replay did not repair cursor {}",
+                        self.next_sequence
+                    );
+                    if let Some(nonce) = &request.nonce {
+                        self.live.unsubscribe(nonce)?;
+                    }
+                    self.request = None;
+                    continue;
+                }
+                request.received += 1;
+                anyhow::ensure!(
+                    request.received <= MAX_REPLAY_BATCHES,
+                    "native KV replay exceeds batch limit"
+                );
+                anyhow::ensure!(
+                    frames[1].starts_with(&self.topic),
+                    "native KV replay topic does not match live subscription"
+                );
+                frames.remove(0);
+                frames
+            } else {
+                multipart_message(self.live.next().await.context("ZMQ stream ended")??)
+            };
+            let decoded = match decode_zmq_kv_batch(frames) {
+                Ok(decoded) => decoded,
+                Err(error) if self.replay.is_none() => {
+                    tracing::warn!(%error, "Failed to decode ZMQ KV batch");
+                    continue;
+                }
+                Err(error) => return Err(error.context("invalid native KV replay source batch")),
+            };
+            if self.replay.is_none() {
+                return Ok(decoded);
+            }
+            if decoded.source_cursor < self.next_sequence {
+                continue;
+            }
+            if decoded.source_cursor > self.next_sequence {
+                anyhow::ensure!(
+                    !replaying,
+                    "native KV replay history is truncated or discontinuous: expected {}, received {}",
+                    self.next_sequence,
+                    decoded.source_cursor
+                );
+                self.request_replay(Some(decoded.source_cursor)).await?;
+                continue;
+            }
+            self.next_sequence = self
+                .next_sequence
+                .checked_add(1)
+                .context("native KV source sequence exhausted")?;
+            return Ok(decoded);
+        }
+    }
+}
+
+impl Drop for NativeZmqSource {
+    fn drop(&mut self) {
+        if let Some(request) = &self.request
+            && request.subscribed
+            && let Some(nonce) = &request.nonce
+        {
+            let _ = self.live.unsubscribe(nonce);
+        }
+    }
+}
