+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tokio::time::timeout;
+
+    struct NativePublisher {
+        _dir: tempfile::TempDir,
+        live: tmq::publish::Publish,
+        replay: tmq::router::Router,
+        source: NativeZmqSource,
+    }
+
+    fn batch_frames(sequence: u64) -> Vec<Vec<u8>> {
+        let event = serde_json::json!({
+            "type": "BlockRemoved", "block_hashes": [-1], "medium": "CPU_PINNED"
+        });
+        vec![
+            b"kv-events".to_vec(),
+            sequence.to_be_bytes().to_vec(),
+            rmp_serde::to_vec_named(&(0.0, vec![event], 0_i32)).unwrap(),
+        ]
+    }
+
+    async fn reply(
+        replay: &mut tmq::router::Router,
+        request: tmq::Multipart,
+        expected: u64,
+        sequences: &[u64],
+    ) {
+        let request = multipart_message(request);
+        assert_eq!(request.len(), 3);
+        assert!(request[1].is_empty());
+        assert_eq!(request[2], expected.to_be_bytes());
+        for sequence in sequences {
+            let mut frames = vec![request[0].clone(), Vec::new()];
+            frames.extend(batch_frames(*sequence));
+            replay.send(frames).await.unwrap();
+        }
+        replay
+            .send(vec![
+                request[0].clone(),
+                Vec::new(),
+                Vec::new(),
+                u64::MAX.to_be_bytes().to_vec(),
+                Vec::new(),
+            ])
+            .await
+            .unwrap();
+    }
+
+    impl NativePublisher {
+        async fn new() -> Self {
+            Self::with_handshake(false).await
+        }
+
+        async fn with_handshake(handshake: bool) -> Self {
+            let dir = tempfile::tempdir().unwrap();
+            let live_endpoint = format!("ipc://{}/live", dir.path().display());
+            let replay_endpoint = format!("ipc://{}/replay", dir.path().display());
+            let live = tmq::publish::publish(&tmq::Context::new())
+                .set_linger(0)
+                .bind(&live_endpoint)
+                .unwrap();
+            let replay = tmq::router::router(&tmq::Context::new())
+                .set_linger(0)
+                .bind(&replay_endpoint)
+                .unwrap();
+            let source = NativeZmqSource::connect(
+                &live_endpoint,
+                "kv-events",
+                Some(&replay_endpoint),
+                handshake,
+            )
+            .await
+            .unwrap();
+            Self {
+                _dir: dir,
+                live,
+                replay,
+                source,
+            }
+        }
+
+        async fn replay(&mut self, sequences: &[u64]) {
+            let request = timeout(Duration::from_secs(2), self.replay.next())
+                .await
+                .unwrap()
+                .unwrap()
+                .unwrap();
+            reply(&mut self.replay, request, 0, sequences).await;
+        }
+
+        // Repeat identical native frames until the SUB handshake completes.
+        // This both avoids a sleep-based readiness assumption and exercises
+        // duplicate delivery without advancing the native sequence.
+        async fn next_with_live(
+            &mut self,
+            sequences: &[u64],
+            mut repair: Option<(u64, &[u64])>,
+        ) -> Result<DecodedZmqKvBatch> {
+            let next = self.source.next();
+            tokio::pin!(next);
+            let mut tick = tokio::time::interval(Duration::from_millis(10));
+            let deadline = tokio::time::sleep(Duration::from_secs(2));
+            tokio::pin!(deadline);
+            loop {
+                tokio::select! {
+                    result = &mut next => return result,
+                    _ = &mut deadline => panic!("native source did not produce a result"),
+                    request = self.replay.next(), if repair.is_some() => {
+                        let (expected, replayed) = repair.take().unwrap();
+                        reply(&mut self.replay, request.unwrap().unwrap(), expected, replayed).await;
+                    }
+                    _ = tick.tick() => {
+                        for sequence in sequences {
+                            self.live.send(batch_frames(*sequence)).await.unwrap();
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn retained_sequence_zero_replays_before_any_live_frame() {
+        let mut native = NativePublisher::new().await;
+        native.replay(&[0]).await;
+        let batch = native.source.next().await.unwrap();
+        assert_eq!(batch.source_cursor, 0);
+        assert!(
+            matches!(&batch.batch.events[0], RawKvEvent::BlockRemoved { medium: Some(medium), block_hashes, .. }
+                if medium == "CPU_PINNED" && matches!(block_hashes.as_slice(), [BlockHashValue::Signed(-1)]))
+        );
+    }
+
+    #[tokio::test]
+    async fn replay_and_live_duplicates_are_admitted_once_in_order() {
+        let mut native = NativePublisher::new().await;
+        native.replay(&[0, 0, 1]).await;
+        assert_eq!(native.source.next().await.unwrap().source_cursor, 0);
+        assert_eq!(native.source.next().await.unwrap().source_cursor, 1);
+        assert_eq!(
+            native
+                .next_with_live(&[0, 1, 2], None)
+                .await
+                .unwrap()
+                .source_cursor,
+            2
+        );
+        assert_eq!(native.source.next_sequence, 3);
+    }
+
+    #[tokio::test]
+    async fn empty_replay_accepts_subsequent_live_sequence_zero() {
+        let mut native = NativePublisher::new().await;
+        native.replay(&[]).await;
+        assert_eq!(
+            native
+                .next_with_live(&[0], None)
+                .await
+                .unwrap()
+                .source_cursor,
+            0
+        );
+    }
+
+    #[tokio::test]
+    async fn live_gap_replays_missing_batches_before_later_batch() {
+        let mut native = NativePublisher::new().await;
+        native.replay(&[0]).await;
+        assert_eq!(native.source.next().await.unwrap().source_cursor, 0);
+        assert_eq!(
+            native
+                .next_with_live(&[3], Some((1, &[1, 2, 3])))
+                .await
+                .unwrap()
+                .source_cursor,
+            1
+        );
+        assert_eq!(native.source.next().await.unwrap().source_cursor, 2);
+        assert_eq!(native.source.next().await.unwrap().source_cursor, 3);
+        assert_eq!(
+            native
+                .next_with_live(&[3, 4], None)
+                .await
+                .unwrap()
+                .source_cursor,
+            4
+        );
+    }
+
+    #[tokio::test]
+    async fn truncated_initial_replay_is_terminal() {
+        let mut native = NativePublisher::new().await;
+        native.replay(&[2]).await;
+        assert!(
+            native
+                .source
+                .next()
+                .await
+                .err()
+                .unwrap()
+                .to_string()
+                .contains("truncated or discontinuous")
+        );
+    }
+
+    #[tokio::test]
+    async fn empty_gap_replay_is_terminal() {
+        let mut native = NativePublisher::new().await;
+        native.replay(&[0]).await;
+        native.source.next().await.unwrap();
+        assert!(
+            native
+                .next_with_live(&[3], Some((1, &[])))
+                .await
+                .err()
+                .unwrap()
+                .to_string()
+                .contains("did not repair")
+        );
+    }
+
+    #[tokio::test]
+    async fn malformed_replay_envelope_is_terminal() {
+        let mut native = NativePublisher::new().await;
+        let request = multipart_message(native.replay.next().await.unwrap().unwrap());
+        native
+            .replay
+            .send(vec![request[0].clone(), b"invalid".to_vec()])
+            .await
+            .unwrap();
+        assert!(
+            native
+                .source
+                .next()
+                .await
+                .err()
+                .unwrap()
+                .to_string()
+                .contains("invalid native KV replay envelope")
+        );
+    }
+
+    #[tokio::test]
+    async fn replay_deadline_is_bounded() {
+        let mut native = NativePublisher::new().await;
+        native.source.request.as_mut().unwrap().deadline = Instant::now();
+        assert!(
+            native
+                .source
+                .next()
+                .await
+                .err()
+                .unwrap()
+                .to_string()
+                .contains("timed out")
+        );
+    }
+
+    #[tokio::test]
+    async fn wrong_replay_topic_is_terminal() {
+        let mut native = NativePublisher::new().await;
+        let request = multipart_message(native.replay.next().await.unwrap().unwrap());
+        let mut batch = batch_frames(0);
+        batch[0] = b"another-engine".to_vec();
+        let mut frames = vec![request[0].clone(), Vec::new()];
+        frames.extend(batch);
+        native.replay.send(frames).await.unwrap();
+        assert!(
+            native
+                .source
+                .next()
+                .await
+                .err()
+                .unwrap()
+                .to_string()
+                .contains("topic does not match")
+        );
+    }
+
+    #[tokio::test]
+    async fn handshake_installs_nonce_before_replay_and_removes_it_at_end() {
+        let mut native = NativePublisher::with_handshake(true).await;
+        let mut request = multipart_message(native.replay.next().await.unwrap().unwrap());
+        assert_eq!(request.len(), 4);
+        let nonce = request.pop().unwrap();
+        assert!(nonce.starts_with(REPLAY_NONCE_PREFIX));
+        assert_eq!(nonce.len(), REPLAY_NONCE_PREFIX.len() + 16);
+        native
+            .replay
+            .send(vec![
+                request[0].clone(),
+                Vec::new(),
+                nonce,
+                REPLAY_READY_SEQUENCE.to_be_bytes().to_vec(),
+                vec![9; 16],
+            ])
+            .await
+            .unwrap();
+        reply(&mut native.replay, request.into(), 0, &[0]).await;
+        assert_eq!(native.source.next().await.unwrap().source_cursor, 0);
+        assert!(native.source.request.as_ref().unwrap().subscribed);
+        assert_eq!(native.source.incarnation, Some([9; 16]));
+        assert_eq!(
+            native
+                .next_with_live(&[1], None)
+                .await
+                .unwrap()
+                .source_cursor,
+            1
+        );
+        assert!(native.source.request.is_none());
+    }
+
+    #[tokio::test]
+    async fn handshake_rejects_wrong_nonce() {
+        let mut native = NativePublisher::with_handshake(true).await;
+        let request = multipart_message(native.replay.next().await.unwrap().unwrap());
+        native
+            .replay
+            .send(vec![
+                request[0].clone(),
+                Vec::new(),
+                b"wrong".to_vec(),
+                REPLAY_READY_SEQUENCE.to_be_bytes().to_vec(),
+                vec![9; 16],
+            ])
+            .await
+            .unwrap();
+        assert!(
+            native
+                .source
+                .next()
+                .await
+                .err()
+                .unwrap()
+                .to_string()
+                .contains("invalid native KV replay subscription challenge")
+        );
+    }
+
+    #[tokio::test]
+    async fn handshake_rejects_data_without_challenge() {
+        let mut native = NativePublisher::with_handshake(true).await;
+        let mut request = multipart_message(native.replay.next().await.unwrap().unwrap());
+        request.pop();
+        reply(&mut native.replay, request.into(), 0, &[0]).await;
+        assert!(
+            native
+                .source
+                .next()
+                .await
+                .err()
+                .unwrap()
+                .to_string()
+                .contains("preceded subscription challenge")
+        );
+    }
+
+    #[tokio::test]
+    async fn handshake_rejects_invalid_or_changed_publisher_incarnation() {
+        for incarnation in [vec![9; 15], vec![8; 16]] {
+            let mut native = NativePublisher::with_handshake(true).await;
+            // A later replay on this source must still identify the publisher
+            // whose earlier native placements were accepted.
+            native.source.incarnation = Some([9; 16]);
+            let request = multipart_message(native.replay.next().await.unwrap().unwrap());
+            native
+                .replay
+                .send(vec![
+                    request[0].clone(),
+                    Vec::new(),
+                    request[3].clone(),
+                    REPLAY_READY_SEQUENCE.to_be_bytes().to_vec(),
+                    incarnation,
+                ])
+                .await
+                .unwrap();
+            let error = native.source.next().await.err().unwrap().to_string();
+            assert!(error.contains("incarnation"), "{error}");
+        }
+    }
